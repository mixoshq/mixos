# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npmrc

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# The one committed env file. .env.docker holds fixed DEV-ONLY secrets for the
# local Docker stack (see its header) so a fresh clone boots with zero manual
# secret generation and connector credentials stay decryptable across restarts.
# The `.env*` rule above would swallow it, hence the explicit negation — which
# must stay AFTER that rule, because git applies the last matching pattern.
!.env.docker
# ...but never the machine-specific half, which scripts/docker-up.ts generates
# from `supabase status -o json` on every boot.
.env.docker.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated
src/generated/


# Supabase CLI local state. `supabase/migrations/` IS committed — these are the
# CLI's scratch dirs (linked project ref, branch metadata, local stack volumes).
supabase/.temp/
supabase/.branches/
