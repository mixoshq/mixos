# Per-instance identity. Copy to .env.instance in a checkout that should be a
# SEPARATE instance — one you install extensions into, or a second tree you want
# running at the same time as this one.
#
# Leave the file absent and this checkout is `mixos` on port 3000 with Supabase
# on 54321, exactly as it has always been. Nothing here is committed: .env* is
# git-ignored, and an instance name that travelled in a release would make every
# install of it the same instance again.
#
# A shell value beats the file, so a one-off is just:
#   MIXOS_INSTANCE=mixos-test MIXOS_PORT=3002 npm run dev:docker

# Compose project, Supabase project id, and half of every container name.
# Lowercase letters, digits, dashes and underscores.
MIXOS_INSTANCE=mixos-dev

# Where the app is published on the host.
MIXOS_PORT=3001

# Supabase's seven ports are derived from this base, keeping their existing
# offsets: api +1, db +2, studio +3, smtp +4, analytics +7, pooler +9, shadow +0.
# The default is 54320, so a second instance wants 54340, a third 54360 — far
# enough apart that the blocks never overlap.
MIXOS_SUPABASE_PORT_BASE=54340

# The edge-runtime inspector, which is not part of the 5432x block.
MIXOS_INSPECTOR_PORT=8084
