# Per-instance identity: which instance, and so which database, this checkout
# is. Every checkout has its own. You rarely need to write this file: when a
# checkout boots under a name another folder already owns, `npm run dev:docker`
# gives it one of its own and writes this file for it. Copy it yourself to choose
# the name.
#
# Leave the file absent and this checkout is `mixos` on port 3000 with Supabase
# on 54321, unless another folder has `mixos` already. Nothing here is committed:
# .env* is git-ignored, and an instance name that travelled in a release would
# make every install of it the same instance again.
#
# A shell value beats the file, so a one-off is just:
#   MIXOS_INSTANCE=mixos-test MIXOS_PORT=3002 npm run dev:docker

# Compose project, Supabase project id, and half of every container name.
# Lowercase letters, digits, dashes and underscores.
MIXOS_INSTANCE=mixos-dev

# Where the app is published on the host. Leave it unset and the app uses 3000;
# when another MixOS is already there, `npm run dev:docker` and `npm run dev`
# say which and offer the next free port. Set it to pin this checkout to one.
# MIXOS_PORT=3001

# Supabase's seven ports are derived from this base, keeping their existing
# offsets: api +1, db +2, studio +3, smtp +4, analytics +7, pooler +9, shadow +0.
# The default is 54320, so a second instance wants 54340, a third 54360 — far
# enough apart that the blocks never overlap.
MIXOS_SUPABASE_PORT_BASE=54340

# The edge-runtime inspector, which is not part of the 5432x block.
MIXOS_INSPECTOR_PORT=8084
