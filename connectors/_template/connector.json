{
  "$schema": "https://mixos.org/schemas/connector/v1.json",
  "name": "_template",
  "displayName": "Template Connector",
  "version": "1.0.0",
  "icon": "assets/icon.svg",
  "description": "Starter template for a service authenticated with a simple API key.",
  "tagline": "One line about the service, for a listing card",
  "keywords": [
    "example",
    "starter"
  ],
  "license": "UNLICENSED",
  "connectorUrl": "https://provider.example.com/",
  "connectorSupportUrl": "https://provider.example.com/support",
  "setup": {
    "title": "Create an API key",
    "steps": [
      {
        "text": "Open API keys and create a key with the smallest scope the feature needs.",
        "link": {
          "label": "API keys",
          "url": "https://provider.example.com/settings/api-keys"
        }
      }
    ],
    "notes": {
      "credentials": "List here anything specific to pasting THIS provider's key — a prefix to include, an environment to pick. Delete the note if there is nothing to say."
    },
    "docs": [
      {
        "label": "API reference",
        "url": "https://docs.provider.example.com/",
        "why": "Say when an admin would open this — e.g. to check which endpoints a key with the smallest scope can reach. A link you cannot say that about is one to leave out."
      }
    ]
  },
  "authors": [
    {
      "name": "Your Name",
      "email": "you@example.com"
    }
  ],
  "credentialFields": [
    {
      "key": "apiKey",
      "label": "API Key",
      "type": "password"
    },
    {
      "key": "baseUrl",
      "label": "Base URL (optional)",
      "type": "text"
    }
  ],
  "auth": {
    "strategy": "apiKey",
    "in": "header",
    "name": "X-Api-Key",
    "credentialKeys": [
      "apiKey"
    ],
    "scopesUrl": "https://docs.provider.example.com/api/scopes"
  },
  "http": {
    "baseUrl": "https://api.example.com",
    "timeoutMs": 10000,
    "maxAttempts": 3,
    "pagination": {
      "style": "cursor",
      "itemsPath": "data",
      "cursorPath": "meta.next_cursor",
      "cursorParam": "cursor",
      "limitParam": "limit",
      "pageSize": 100
    }
  },
  "telemetry": [
    {
      "method": "listItems",
      "operation": "GET /items",
      "description": "Listed items"
    },
    {
      "method": "getItem",
      "operation": "GET /items/{id}",
      "description": "Read one item"
    },
    {
      "method": "createItem",
      "operation": "POST /items",
      "description": "Created an item",
      "mutates": true
    }
  ]
}
