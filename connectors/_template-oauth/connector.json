{
  "name": "_template-oauth",
  "displayName": "Template Connector (OAuth)",
  "icon": "assets/icon.svg",
  "description": "Starter template for a service using three-legged OAuth, where an admin approves access once.",
  "setup": {
    "title": "Create an OAuth app",
    "steps": [
      {
        "text": "Create an OAuth application of type Web server in the Developer console, then add this redirect URI to its allowed redirect URIs:",
        "link": {
          "label": "Developer console",
          "url": "https://provider.example.com/settings/apps"
        },
        "why": "Rationale goes here, behind a \"?\" the reader opens only if they care — why this setting, why this scope. Anything they must DO belongs in \"text\".",
        "showRedirectUri": true,
        "values": [
          "Web server"
        ]
      }
    ],
    "notes": {
      "authorize": "Whichever account approves this is the account every user of the deployment acts as. Say whose account that should be. The registry already explains what OAuth is and shows the scopes — don't repeat either."
    },
    "docs": [
      {
        "label": "OAuth scopes reference",
        "url": "https://docs.provider.example.com/oauth/scopes"
      }
    ]
  },
  "authors": [
    {
      "name": "Your Name",
      "email": "you@example.com"
    }
  ],
  "credentialFields": [
    {
      "key": "clientId",
      "label": "Client ID",
      "type": "text"
    },
    {
      "key": "clientSecret",
      "label": "Client Secret",
      "type": "password"
    },
    {
      "key": "webhookSecret",
      "label": "Webhook Signing Secret",
      "type": "password"
    }
  ],
  "auth": {
    "strategy": "oauth2_authorization_code",
    "authorizeUrl": "https://provider.example.com/oauth/authorize",
    "tokenUrl": "https://provider.example.com/oauth/token",
    "tokenAuth": "basic",
    "credentialKeys": [
      "clientId",
      "clientSecret"
    ],
    "scopes": [
      {
        "scope": "things:read",
        "description": "View your things",
        "access": "read",
        "requested": true
      },
      {
        "scope": "things:write",
        "description": "Create, edit and delete your things",
        "access": "write",
        "requested": false
      }
    ],
    "scopesUrl": "https://docs.provider.example.com/oauth/scopes"
  },
  "http": {
    "baseUrl": "https://api.provider.example.com",
    "timeoutMs": 10000,
    "maxAttempts": 3
  },
  "webhook": {
    "algorithm": "hmac-sha256",
    "signatureHeader": "X-Provider-Signature",
    "timestampHeader": "X-Provider-Timestamp",
    "toleranceSeconds": 300,
    "secretKey": "webhookSecret"
  },
  "telemetry": [
    {
      "method": "listThings",
      "description": "Listed things"
    }
  ]
}
