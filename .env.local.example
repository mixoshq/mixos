# ─────────────────────────────────────────────────────────────────────────────
# MixOS — local environment
#
# YOU PROBABLY DO NOT NEED THIS FILE. The default local path is Docker:
# `npm run dev:docker` boots Postgres, PostgREST, and the app, and supplies
# every variable below from the committed .env.docker plus a generated
# .env.docker.local. See docs/local-docker.md.
#
# This file is for the alternative path — a hosted Supabase project with the app
# running on your host Node — and for running host `npm run dev` against the
# containerized database (in which case only the Supabase/Postgres block below
# needs filling in, pointed at 127.0.0.1:54321 and 127.0.0.1:54322).
#
# Copy to .env.local and fill in. In production these are set as Vercel project
# environment variables instead; nothing here is read from a file in a
# deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth (NextAuth / Auth.js) ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Canonical public URL of this deployment. Used for OAuth redirect URIs, the MCP
# resource identifier, and the OAuth discovery documents — all of which must
# never be derived from a request header. On Vercel this falls back to the
# platform's own VERCEL_URL when unset, but set it explicitly in production.
NEXTAUTH_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings -> API in the Supabase dashboard.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row-Level Security and is a full-database
# credential. It is deliberately NOT NEXT_PUBLIC_-prefixed so Next.js cannot
# inline it into a client bundle. Never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection for the handful of queries PostgREST can't express
# (analytics aggregates, the scheduler's atomic claim, telemetry rollups).
#
# Use the POOLER connection string (port 6543, "...pooler.supabase.com") from
# Project Settings -> Database -> Connection string -> Transaction pooler.
# Serverless functions scale to many short-lived instances, and the direct
# port-5432 endpoint runs out of connections quickly under that pattern.
# Copy the URL verbatim — the password is already percent-encoded in it.
DATABASE_URL=

# Alternative to DATABASE_URL: discrete fields, which need no URL escaping.
# Handy against a plain local Postgres. Ignored when DATABASE_URL is set.
# PGSSLMODE accepts: disable, require, verify-full. Defaults to `require`.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=mix
# PGSSLMODE=disable

# Pointing at a LOCAL Postgres — including the Supabase CLI's, whether you
# reached it via DATABASE_URL or the PG* fields above — requires this, not just
# the commented example line. The default when PGSSLMODE is unset is `require`
# (src/lib/db/pg-options.ts), and the local server speaks plaintext only, so
# every query fails at the TLS handshake without it. The Docker path sets this
# for you in .env.docker.
# PGSSLMODE=disable

# ── Secrets ──────────────────────────────────────────────────────────────────
# AES-256-GCM key for TENANT connector credentials (connector_configs) and for
# the short-lived connector OAuth flow-state cookie. Nothing else derives from it
# any more — see the key inventory below.
# Rotating: an admin re-enters every connector's credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_ENCRYPTION_KEY=

# HMAC secret for app password-unlock cookies (apps with password-protected
# pages or API routes — see docs/apps/pages.md). Kept separate from AUTH_SECRET
# so rotating one doesn't invalidate the other.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_UNLOCK_SECRET=

# ── The rest of the key inventory ───────────────────────────────────────────
# Each of these protects one thing and one thing only. They were once a single
# secret (or derived from it), which made that secret impossible to rotate:
# changing it broke every connector credential, every MCP token, every app API
# key and every unlock cookie at the same moment. Independent keys mean a
# bounded, predictable blast radius per rotation.
#
# All six are 32 random bytes, hex-encoded. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# The full inventory, with what rotating each one costs, is in
# src/lib/env/keys.ts and docs/security-architecture.md section 5.

# Per-user OAuth grants for `userScoped` connectors (user_connector_oauth).
# Rotating: every person reconnects their own account.
USER_OAUTH_ENCRYPTION_KEY=

# HMAC digests for MCP access tokens, refresh tokens and authorization codes.
# Rotating: every MCP client re-authorizes.
MCP_TOKEN_KEY=

# HMAC digests for app API keys (the `key` auth tier).
# Rotating: every integration's key must be re-minted.
APP_API_KEY_SECRET=

# `password`-typed app settings surfaced as context.env (app_settings).
# Rotating: an admin re-enters each encrypted setting.
APP_SETTINGS_ENCRYPTION_KEY=

# Shared secret for the scheduler endpoint. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>` when it calls /api/cron. The route
# refuses to run when this is unset rather than defaulting open, so background
# jobs simply won't fire until it is set.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Access control ───────────────────────────────────────────────────────────
# Allowed email domains for user provisioning (comma-separated, optional).
# When set, only users with matching email domains can sign in. Blank = any.
ALLOWED_EMAIL_DOMAINS=

# Comma-separated browser origins allowed to read apps' public embed endpoints
# (CORS). Leave blank unless an app serves a cross-origin public surface.
MONTALBANO_APP_ORIGINS=

# ── Extension installs (optional) ────────────────────────────────────────────
# Whether admins can browse the catalogue for each kind and install from it.
# All three default to true. `false` removes the kind's Browse button, makes its
# browse page a 404, and makes the server actions behind it refuse — so an
# instance runs only the extensions it was deployed with. Anything that is not
# true/false (or 1/0, yes/no, on/off) is read as false. Installed extensions are
# unaffected. See docs/hosting/README.md#fixing-what-an-instance-runs.
# INSTALL_APPS=true
# INSTALL_CONNECTORS=true
# INSTALL_THEMES=true

# ── Extension repository (optional) ──────────────────────────────────────────
# The catalogue that /admin/{apps,connectors,themes}/browse searches, and that
# supplies the checksum each download is verified against. Defaults to
# https://mixos.org; nothing needs setting for the normal case.
#
# https is required, except on localhost, 127.0.0.1, [::1] and
# host.docker.internal — the hosts where the traffic cannot leave this machine.
# A plaintext catalogue over a real network would let anyone on the path choose
# which checksum this instance verifies against, and a checksum the attacker
# picked verifies whatever the attacker sent.
#
# This file is the HOST path (`npm run dev`). On the Docker stack put it in
# .env.docker instead — .env.docker.local is regenerated on every boot.
#
# Point it at a local checkout of the site (`astro dev`, port 4321) or at a
# fixture server to exercise the browse and register flow. Note that the seeded
# catalogue publishes placeholder checksums, so browsing works against it and
# installing is refused. See docs/security-architecture.md section 31.
# MIXOS_REPOSITORY_URL=https://mixos.org

# ── Web Push (optional) ──────────────────────────────────────────────────────
# Required only for the notifications capability (apps that set
# "notifications": true — see docs/apps/notifications.md).
# Generate with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https: contact URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:amix@gmail.com

# ── First-run only ───────────────────────────────────────────────────────────
# Consumed once by `npm run seed-admin` to create the initial admin account.
# Delete after the admin exists.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
