# Development image: `next dev` with hot reload, source bind-mounted by compose.
#
# The counterpart to Dockerfile. That one builds; this one only ever needs a
# node_modules tree — docker-compose.yml mounts the working copy over /app, so
# baking source in here would be dead weight that goes stale the moment the
# mount lands on top of it.
#
# Same base as the prod image (node:24-bookworm-slim, glibc) so the @next/swc
# native binding Turbopack needs resolves, and so dev and prod differ in as few
# ways as possible.
FROM node:24-bookworm-slim
WORKDIR /app

ENV NODE_ENV=development \
    NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./

# This install is load-bearing beyond just having dependencies present. Compose
# mounts a *named volume* at /app/node_modules, and Docker seeds a named volume
# from whatever the image already has at that path the first time it is created.
# So this layer is what populates that volume — and the volume in turn is what
# stops the host's macOS/arm64 node_modules (bind-mounted at /app) from shadowing
# the Linux one. Those trees are not interchangeable: @next/swc ships a different
# native binary per platform.
RUN npm ci --no-audit --no-fund

EXPOSE 3000

# Deliberately running as root. The bind mount is owned by the host user, and
# `predev` writes src/generated/ back into it; on Docker Desktop for macOS the
# uid is remapped so this is invisible, but dropping to uid 1000 would break the
# same mount on Linux. Prod runs unprivileged — see Dockerfile.
#
# `npm run dev`, not `npx next dev`, so the `predev` hook regenerates the app and
# connector registries (src/generated/ is gitignored and may not exist yet). The
# bare `--` is required for npm to forward the flags to next rather than eat them.
#
# -H 0.0.0.0 is technically redundant — Next 16's `next dev` already defaults to
# 0.0.0.0 — but a dev server in a container that binds loopback is invisible from
# the host, and that is not a failure anyone should have to rediscover from the
# CLI docs. Note the flip side, which the README covers: Next's cross-site dev
# guard allowlists only localhost, so browse to http://localhost:3000 and not
# http://127.0.0.1:3000, or every /_next/* chunk and the HMR socket 403.
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0", "-p", "3000"]
