# Four jobs, whenever an app, connector, or theme is part of this commit:
#
#   1. Stamp `lastUpdated` on every app/connector/theme manifest the commit
#      touches, and re-stage it so the date ships with the change it describes.
#      A merge or cherry-pick stamps only what it changes itself, not what it
#      brings in as the other side has it — see scripts/stamp-updated.ts.
#   2. Refuse an edit to an existing remix entry in an app's `remixedFrom`.
#   3. Refuse a connector change that breaks its contract: a version that goes
#      backwards, or a method removed or made into a write without a new major
#      version — see scripts/check-connector-contract.ts.
#   4. Validate app/connector/theme manifests (and rebuild the gitignored
#      src/generated/*.ts). The generator schema-validates every app.json /
#      connector.json / theme.json — and compiles each theme.css against the
#      token contract — aborting loudly on a bad manifest, so wiring it here
#      fails the commit before a broken manifest can land.
#
# Order matters: stamp first, then regenerate, so the registry picks up the dates
# written a moment ago instead of lagging a commit behind.
#
# The stamp step never blocks a commit — a missing date is cosmetic. Validation
# does block, because a broken manifest is not.
#
# Activated via core.hooksPath (.githooks), set by the package.json `prepare`
# script on `npm install`. To run manually: npx tsx scripts/stamp-updated.ts
# followed by npm run registry.
set -euo pipefail

# Only run when a manifest/structure under apps/, connectors/ or themes/ is part
# of this commit — keeps unrelated commits fast. On a merge this includes what
# the merge brings in, so those manifests are validated even when none is
# stamped.
#
# core.quotePath=false matters: by default git C-quotes a non-ASCII path
# (`"apps/a/na\303\257ve.txt"`), which starts with a double quote and so fails
# the `^(apps/` test below — the hook would skip both the stamp and manifest
# validation for that commit without a word.
staged="$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRD)"
if ! printf '%s\n' "$staged" | grep -qE '^(apps/|connectors/|themes/)'; then
  exit 0
fi

# A hook runs in whatever shell the git client started, which is often not a
# login shell and so may find an older Node than your terminal does. Say so
# plainly here rather than failing inside tsx — see scripts/check-node.mjs.
node scripts/check-node.mjs

# Stamps what changed and `git add`s the manifests it wrote. Exits 0 even on
# failure, by design — see the header of scripts/stamp-updated.ts.
npx tsx scripts/stamp-updated.ts

# A remix entry in an app's `remixedFrom` is written once and never edited —
# it records the moment the remix was taken. Blocks, like validation below.
# See scripts/check-remix-provenance.ts and docs/apps/remix.md.
npx tsx scripts/check-remix-provenance.ts

# Within a major version a connector only adds: an app built against an
# earlier release of it must still find what it calls. Blocks, like validation
# below. See scripts/check-connector-contract.ts.
npx tsx scripts/check-connector-contract.ts

echo "[pre-commit] apps/, connectors/ or themes/ changed — validating manifests…"
# Non-zero on a bad manifest — exactly what we want before a commit lands.
npm run --silent registry >/dev/null
