# ─────────────────────────────────────────────────────────────────────────────
# deploy/.env — read by deploy/docker-compose.yml.
#
# Don't fill this in by hand: `sh deploy/new-env.sh <public URL> [admin email]`
# writes deploy/.env with every secret generated. This file says what each
# value is, for when you need to change one. On Coolify or Dokploy, the same
# names go in the service's environment settings instead (docs/hosting/).
#
# deploy/.env is gitignored and excluded from the Docker build context. Keep a
# copy somewhere safe: three of these keys decrypt data in the database, and
# without them that data is gone.
# ─────────────────────────────────────────────────────────────────────────────

# The public URL people sign in at, with its scheme. OAuth redirect URIs and the
# MCP resource identifier are built from it, so it must be exactly what the
# browser shows. With deploy/docker-compose.https.yml, Caddy also takes the
# certificate's hostname from it.
MIXOS_URL=https://mixos.example.com

# The `mixos` role's password on the bundled Postgres. Hex, so it needs no
# escaping inside the connection URL compose builds from it. Changing it later
# means changing it inside Postgres too: the database keeps the password it was
# initialised with.
POSTGRES_PASSWORD=

# Auth.js session signing. Rotating it signs everyone out.
AUTH_SECRET=

# The platform key inventory — see src/lib/env/keys.ts for what each protects
# and what rotating it costs. Each is 32 random bytes: 64 hex characters (what
# `openssl rand -hex 32` and `npm run keys:generate` print) or base64.
CONNECTOR_ENCRYPTION_KEY=
USER_OAUTH_ENCRYPTION_KEY=
APP_SETTINGS_ENCRYPTION_KEY=
MCP_TOKEN_KEY=
APP_API_KEY_SECRET=
APP_UNLOCK_SECRET=

# The scheduler tick's bearer token; the `cron` service sends it.
CRON_SECRET=

# The first admin, created by the release step if no account has this email.
# Never changed afterwards, so it is safe to leave set. Leave both blank to
# create no account.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────────────────
# Comma-separated email domains allowed to sign in. Blank: any.
# ALLOWED_EMAIL_DOMAINS=example.com

# Web Push, for apps with "notifications": true. npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Whether admins can browse the catalogue for each kind. This image cannot
# install from the catalogue in any case — installing needs a source checkout —
# so `false` removes browsing as well: no Browse button, a 404 for the page.
# Default true. See docs/hosting/README.md#fixing-what-an-instance-runs.
# INSTALL_APPS=false
# INSTALL_CONNECTORS=false
# INSTALL_THEMES=false

# Once a day, ask mixos.org about the extensions installed from it, so admins
# see a release its publisher withdrew. Sends a random ID for this instance and
# each extension's kind, slug and version, nothing else. Also asks which
# releases of MixOS exist, an anonymous GET, so admins see when a newer one is
# out. Default true; false sends nothing for either. See
# docs/hosting/README.md#what-mixos-sends-to-mixosorg.
# MIXOS_UPDATE_CHECK=false

# Which releases of MixOS the admin pages announce: stable (the default), or
# prerelease to add tags such as v0.3.0-rc.1. Anything else is read as stable.
# See docs/hosting/README.md#new-releases-of-mixos.
# MIXOS_RELEASE_CHANNEL=prerelease

# Turns on Admin > GitHub, which links this instance to its repository through
# a GitHub App you own. 32 random bytes: `openssl rand -hex 32`. The App's
# private key is stored encrypted under it, so back it up with the rest. See
# docs/hosting/README.md#linking-your-github-repository.
# GITHUB_APP_ENCRYPTION_KEY=

# The host port the app is published on, on 127.0.0.1 only. Default 3000.
# MIXOS_PORT=3000

# The commit the admin pages show beside the MixOS version. Not set here, where
# it would go stale: pass it from the shell when you build,
#   MIXOS_COMMIT=$(git rev-parse HEAD) docker compose -f deploy/docker-compose.yml build
# On Coolify, set MIXOS_COMMIT=$SOURCE_COMMIT in the resource's environment.
