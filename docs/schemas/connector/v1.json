{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixos.org/schemas/connector/v1.json",
  "title": "connector.json",
  "description": "A MixOS connector's manifest, connectors/<slug>/connector.json.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://mixos.org/schemas/connector/v1.json",
      "description": "This file's shape, and the version of it."
    },
    "registryId": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{8}$",
      "description": "The install name: the extension's folder, URL, database schema and Registry listing are named after it. Minted once, by `npm run new` or `npm run rename`, and never changed."
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "userScoped": {
      "type": "boolean"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "description": {
      "type": "string",
      "maxLength": 140
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\n\\r]+$"
    },
    "keywords": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 32,
        "pattern": "^[a-z0-9]+(?:[ -][a-z0-9]+)*$"
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "connectorUrl": {
      "type": "string",
      "minLength": 1
    },
    "connectorSupportUrl": {
      "type": "string",
      "minLength": 1
    },
    "setup": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "link": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "label",
                  "url"
                ],
                "additionalProperties": false
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "showRedirectUri": {
                "type": "boolean"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "object",
          "properties": {
            "credentials": {
              "type": "string",
              "minLength": 1
            },
            "authorize": {
              "type": "string",
              "minLength": 1
            },
            "verify": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "label",
              "url",
              "why"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "steps"
      ],
      "additionalProperties": false
    },
    "credentialFields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "password"
            ]
          }
        },
        "required": [
          "key",
          "label",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "email"
        ],
        "additionalProperties": false
      }
    },
    "telemetry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "mutates": {
            "type": "boolean"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "method",
          "operation"
        ],
        "additionalProperties": false
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "none",
            "apiKey",
            "basic",
            "oauth2_client_credentials",
            "oauth2_authorization_code"
          ]
        },
        "in": {
          "type": "string",
          "enum": [
            "header",
            "query",
            "bearer"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string"
        },
        "credentialKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tokenUrl": {
          "type": "string",
          "format": "uri"
        },
        "tokenAuth": {
          "type": "string",
          "enum": [
            "basic",
            "post"
          ]
        },
        "authorizeUrl": {
          "type": "string",
          "format": "uri"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "access": {
                "type": "string",
                "enum": [
                  "read",
                  "write",
                  "read-write"
                ]
              },
              "requested": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "const": "write"
                  }
                ]
              }
            },
            "required": [
              "scope",
              "requested"
            ],
            "additionalProperties": false
          }
        },
        "scopesUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false
    },
    "http": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120000
        },
        "deadlineMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120000
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "retryOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "unconfigured",
              "auth_failed",
              "forbidden",
              "rate_limited",
              "not_found",
              "invalid_request",
              "conflict",
              "payload_too_large",
              "timeout",
              "upstream_error",
              "network_error",
              "unexpected_response"
            ]
          }
        },
        "defaultHeaders": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "rateLimitOn403": {
          "type": "boolean"
        },
        "maxResponseBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "pagination": {
          "type": "object",
          "properties": {
            "style": {
              "type": "string",
              "enum": [
                "cursor",
                "offset",
                "page",
                "link-header"
              ]
            },
            "itemsPath": {
              "type": "string",
              "minLength": 1
            },
            "cursorPath": {
              "type": "string",
              "minLength": 1
            },
            "cursorParam": {
              "type": "string",
              "minLength": 1
            },
            "limitParam": {
              "type": "string",
              "minLength": 1
            },
            "offsetParam": {
              "type": "string",
              "minLength": 1
            },
            "pageParam": {
              "type": "string",
              "minLength": 1
            },
            "pageSize": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxPages": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "style"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "webhook": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "hmac-sha256",
            "hmac-sha1"
          ]
        },
        "signatureHeader": {
          "type": "string",
          "minLength": 1
        },
        "timestampHeader": {
          "type": "string",
          "minLength": 1
        },
        "toleranceSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "algorithm",
        "signatureHeader",
        "secretKey"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "registryId",
    "displayName",
    "version"
  ]
}
