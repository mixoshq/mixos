{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixos.org/schemas/extension-renames/v1.json",
  "title": "extension-renames.json",
  "description": "The rename ledger at the root of a MixOS checkout, extension-renames.json: each extension renamed there, so every instance's data follows it. Written by `npm run rename`.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://mixos.org/schemas/extension-renames/v1.json",
      "description": "This file's shape, and the version of it."
    },
    "renames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "app",
              "connector",
              "theme"
            ]
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "kind",
          "from",
          "to",
          "date"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "renames"
  ]
}
