{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixos.org/schemas/theme/v1.json",
  "title": "theme.json",
  "description": "A MixOS theme's manifest, themes/<slug>/theme.json.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://mixos.org/schemas/theme/v1.json",
      "description": "This file's shape, and the version of it."
    },
    "registryId": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{8}$",
      "description": "The install name: the extension's folder, URL, database schema and Registry listing are named after it. Minted once, by `npm run new` or `npm run rename`, and never changed."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\n\\r]+$"
    },
    "keywords": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 32,
        "pattern": "^[a-z0-9]+(?:[ -][a-z0-9]+)*$"
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "themeUrl": {
      "type": "string",
      "minLength": 1
    },
    "themeSupportUrl": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "email"
        ],
        "additionalProperties": false
      }
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "style": {
            "default": "normal",
            "type": "string",
            "enum": [
              "normal",
              "italic"
            ]
          },
          "display": {
            "type": "string",
            "enum": [
              "auto",
              "block",
              "swap",
              "fallback",
              "optional"
            ]
          }
        },
        "required": [
          "family",
          "file",
          "weight"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "object",
      "properties": {
        "logo": {
          "type": "string",
          "minLength": 1
        },
        "favicon": {
          "type": "string",
          "minLength": 1
        },
        "appIcon192": {
          "type": "string",
          "minLength": 1
        },
        "appIcon512": {
          "type": "string",
          "minLength": 1
        },
        "preview": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "branding": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "menuBarLogo": {
          "type": "string",
          "minLength": 1
        },
        "loginLogo": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "screenshots": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 13
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "file"
        ],
        "additionalProperties": false
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "escapes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "const": "contrast-aa"
          },
          "pair": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 15
          }
        },
        "required": [
          "rule",
          "pair",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "registryId",
    "name",
    "description"
  ]
}
