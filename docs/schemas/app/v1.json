{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixos.org/schemas/app/v1.json",
  "title": "app.json",
  "description": "A MixOS app's manifest, apps/<slug>/app.json.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://mixos.org/schemas/app/v1.json",
      "description": "This file's shape, and the version of it."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "description": {
      "type": "string"
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\n\\r]+$"
    },
    "icon": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "email"
        ],
        "additionalProperties": false
      }
    },
    "keywords": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 32,
        "pattern": "^[a-z0-9]+(?:[ -][a-z0-9]+)*$"
      }
    },
    "screenshots": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 13
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "file"
        ],
        "additionalProperties": false
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "appUrl": {
      "type": "string",
      "minLength": 1
    },
    "appSupportUrl": {
      "type": "string",
      "minLength": 1
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "access": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "optionalConnectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "access": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "database": {
      "type": "boolean"
    },
    "updatedAt": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z_][a-z0-9_]*$"
          },
          "column": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z_][a-z0-9_]*$"
          }
        },
        "required": [
          "table"
        ],
        "additionalProperties": false
      }
    },
    "notifications": {
      "type": "boolean"
    },
    "global": {
      "type": "boolean"
    },
    "escapes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "enum": [
              "raw-response"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 20
          }
        },
        "required": [
          "rule",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "password"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "label",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "egress": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
      }
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "defaultSize": {
            "type": "object",
            "properties": {
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            },
            "required": [
              "w",
              "h"
            ],
            "additionalProperties": false
          },
          "minSize": {
            "type": "object",
            "properties": {
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            },
            "required": [
              "w",
              "h"
            ],
            "additionalProperties": false
          },
          "config": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "number",
                    "boolean",
                    "select",
                    "multiselect"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "default": {},
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "label",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                },
                "ordered": {
                  "type": "boolean"
                }
              },
              "required": [
                "key",
                "label",
                "type"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "description",
          "component"
        ],
        "additionalProperties": false
      }
    },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "everyMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 9007199254740991
          },
          "cron": {
            "type": "string",
            "minLength": 1
          },
          "timezone": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "emits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "consumers": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              {
                "type": "string",
                "const": "*"
              }
            ]
          }
        },
        "required": [
          "name",
          "consumers"
        ],
        "additionalProperties": false
      }
    },
    "listensTo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "minLength": 1
          },
          "hook": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "app",
          "hook"
        ],
        "additionalProperties": false
      }
    },
    "branding": {
      "type": "object",
      "properties": {
        "hooks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "brand-name",
              "menu-bar-logo",
              "login-logo"
            ]
          }
        },
        "reason": {
          "type": "string",
          "minLength": 20
        },
        "logos": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "hooks",
        "reason"
      ],
      "additionalProperties": false
    },
    "sync": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "schedule": {
            "type": "object",
            "properties": {
              "everyMinutes": {
                "type": "integer",
                "minimum": 5,
                "maximum": 9007199254740991
              },
              "cron": {
                "type": "string",
                "minLength": 1
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "window": {
            "type": "object",
            "properties": {
              "coldStartDays": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "defaultDays": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "minDays": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "coldStartDays",
              "defaultDays",
              "minDays"
            ],
            "additionalProperties": false
          },
          "budgetMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 200000
          }
        },
        "required": [
          "name",
          "schedule",
          "source",
          "window",
          "budgetMs"
        ],
        "additionalProperties": false
      }
    },
    "pageVisibility": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "session",
            "signed-in",
            "password",
            "key",
            "public"
          ]
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "defaultRole": {
      "type": "string",
      "minLength": 1
    },
    "telemetry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "audience": {
            "type": "string",
            "enum": [
              "user",
              "app"
            ]
          },
          "consumers": {
            "anyOf": [
              {
                "type": "string",
                "const": "*"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "required": [
          "name",
          "consumers"
        ],
        "additionalProperties": false
      }
    },
    "consumes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "minLength": 1
          },
          "service": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "app",
          "service"
        ],
        "additionalProperties": false
      }
    },
    "mcp": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "hint": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notCovered": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "description",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "remixedFrom": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "remixedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "source": {
            "type": "object",
            "properties": {
              "app": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              },
              "commitSha": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "commitFrom": {
                "type": "string",
                "enum": [
                  "install-record",
                  "git"
                ]
              },
              "modified": {
                "type": "boolean"
              },
              "registry": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "origin": {
                        "type": "string",
                        "format": "uri"
                      },
                      "slug": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$"
                      }
                    },
                    "required": [
                      "origin",
                      "slug",
                      "version"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "anchors": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "app",
              "commitSha",
              "commitFrom",
              "modified",
              "registry",
              "anchors"
            ],
            "additionalProperties": false
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "keywords": {
            "minItems": 2,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "license": {
            "type": "object",
            "properties": {
              "spdx": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "adapted",
                  "rebuilt"
                ]
              }
            },
            "required": [
              "spdx",
              "mode"
            ],
            "additionalProperties": false
          },
          "actions": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "same",
                "different",
                "remove"
              ]
            }
          },
          "hiddenRules": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "same",
                "different",
                "remove"
              ]
            }
          },
          "partsRemoved": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "landedIn": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._[\\]\\/-]+$"
            }
          }
        },
        "required": [
          "remixedAt",
          "source",
          "summary",
          "keywords",
          "license",
          "actions",
          "landedIn"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "name"
  ]
}
