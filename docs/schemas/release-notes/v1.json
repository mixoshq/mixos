{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixos.org/schemas/release-notes/v1.json",
  "title": "release-notes.json",
  "description": "An extension's release notes, release-notes.json beside its manifest: one line each, newest first.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://mixos.org/schemas/release-notes/v1.json",
      "description": "This file's shape, and the version of it."
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "date",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "notes"
  ]
}
