{
  "name": "mixos",
  "version": "0.8.0",
  "private": true,
  "license": "MPL-2.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true; [ ! -f scripts/core-excludes.ts ] || tsx scripts/core-excludes.ts || true",
    "predev": "node scripts/check-node.mjs && tsx scripts/generate-project-registry.ts",
    "dev": "tsx scripts/dev.ts",
    "status": "node scripts/check-node.mjs && tsx scripts/status.ts",
    "desktop:mac": "bash desktop/macos/build.sh",
    "dev:docker": "node scripts/check-node.mjs && tsx scripts/docker-up.ts",
    "docker:prod": "node scripts/check-node.mjs && tsx scripts/docker-up.ts --prod",
    "docker:down": "tsx scripts/docker-down.ts",
    "docker:reset": "tsx scripts/docker-down.ts --reset",
    "prebuild": "node scripts/check-node.mjs && tsx scripts/generate-project-registry.ts",
    "pretypecheck": "node scripts/check-node.mjs && tsx scripts/generate-project-registry.ts",
    "build": "next build",
    "vercel-build": "npm run build && tsx scripts/vercel-release.ts",
    "start": "next start",
    "prelint": "node scripts/check-node.mjs && tsx scripts/generate-project-registry.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "keys:check": "tsx scripts/generate-keys.ts --check",
    "keys:rotate-github-app": "tsx scripts/rekey-github-app.ts",
    "verify:connectors": "tsx scripts/verify-connectors.ts",
    "verify:repository-url": "tsx scripts/check-repository-url.ts",
    "registry": "node scripts/check-node.mjs && tsx scripts/generate-project-registry.ts",
    "supabase": "tsx scripts/supabase.ts",
    "db:push": "tsx scripts/supabase.ts db push",
    "db:reset": "tsx scripts/supabase.ts db reset",
    "db:local": "tsx scripts/supabase.ts migration up --local",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "release": "node scripts/check-node.mjs && tsx scripts/generate-project-registry.ts && tsx scripts/release.ts",
    "build:ops": "esbuild scripts/release.ts scripts/seed-admin.ts scripts/rekey-github-app.ts --bundle --platform=node --target=node22 --format=cjs --outdir=ops --out-extension:.js=.cjs --external:@apps/* --log-level=warning && node -e \"require('fs').copyFileSync(require.resolve('libpg-query/wasm/libpg-query.wasm'), 'ops/libpg-query.wasm')\"",
    "premigrate:apps": "node scripts/check-node.mjs && tsx scripts/generate-project-registry.ts",
    "migrate:apps": "tsx scripts/migrate.ts",
    "seed-admin": "tsx scripts/seed-admin.ts",
    "stamp": "tsx scripts/stamp-updated.ts",
    "schemas": "tsx scripts/json-schemas.ts",
    "register": "node scripts/check-node.mjs && tsx scripts/register.ts",
    "remove": "node scripts/check-node.mjs && tsx scripts/remove.ts",
    "rename": "node scripts/check-node.mjs && tsx scripts/rename.ts",
    "new": "node scripts/check-node.mjs && tsx scripts/new-extension.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "croner": "^10.0.1",
    "cronstrue": "^3.24.0",
    "libpg-query": "^18.1.5",
    "lucide-react": "^1.8.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-grid-layout": "^2.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "danger": "^14.0.7",
    "esbuild": "^0.27.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "sharp": "^0.35.5",
    "supabase": "^2.34.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.27.7": true,
    "unrs-resolver@1.11.1": true
  }
}
